---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin – BugJu" description="Administrationsbereich.">
  <section class="admin">
    <header class="admin-header">
      <div>
        <h1>Adminbereich</h1>
        <p class="text-muted" id="admin-user">Status wird geprüft …</p>
      </div>
    </header>

    <div id="admin-loading" class="text-muted">Wird geladen …</div>

    <div id="admin-denied" hidden>
      <p>Kein Zugriff – dieser Bereich ist nur für Administratoren.</p>
      <p>
        <a class="btn" href="/login?redirect=/admin">Zum Login</a>
      </p>
    </div>

    <div id="admin-area" hidden>
      <section class="panel">
        <h2>Mitglieder</h2>
        <p class="text-muted">
          Rolle per Klick wechseln. <strong>Admin</strong> darf Mitglieder
          verwalten, <strong>Mitglied</strong> hat nur Lesezugriff. Die eigene
          Rolle lässt sich nicht ändern.
        </p>
        <ul id="user-list" class="user-list"></ul>
        <p id="user-empty" class="text-muted" hidden>Keine Mitglieder gefunden.</p>
        <p id="user-error" class="form-error" hidden></p>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import { supabase, isSupabaseConfigured } from '../lib/supabase';

  const escapeHtml = (value: string): string =>
    value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

  (async () => {
    const loadingEl = document.getElementById('admin-loading');
    const deniedEl = document.getElementById('admin-denied');
    const areaEl = document.getElementById('admin-area');
    const userEl = document.getElementById('admin-user');

    const userListEl = document.getElementById('user-list');
    const userEmptyEl = document.getElementById('user-empty');
    const userErrorEl = document.getElementById('user-error');

    const showDenied = (msg: string) => {
      if (loadingEl) loadingEl.hidden = true;
      if (areaEl) areaEl.hidden = true;
      if (deniedEl) deniedEl.hidden = false;
      if (userEl) userEl.textContent = msg;
    };

    if (!isSupabaseConfigured) {
      showDenied('Konfiguration fehlt (Supabase).');
      return;
    }

    // --- Zugriff prüfen: nur Admins dürfen hier weiter ---
    const { data: sessionData } = await supabase.auth.getSession();
    const session = sessionData.session;
    if (!session) {
      window.location.replace('/login?redirect=/admin');
      return;
    }

    const { data: roleRow } = await supabase
      .from('user_roles')
      .select('role')
      .eq('user_id', session.user.id)
      .maybeSingle();

    const myRole = (roleRow?.role as string) ?? 'member';
    if (myRole !== 'admin') {
      showDenied('Angemeldet, aber ohne Admin-Rechte.');
      return;
    }

    if (userEl) userEl.textContent = `${session.user.email ?? 'Admin'} · Rolle: admin`;
    if (loadingEl) loadingEl.hidden = true;
    if (areaEl) areaEl.hidden = false;

    // ============================================================
    // Mitglieder & Rollen
    // ============================================================
    const renderRoleToggle = (userId: string, role: string) => `
      <div class="role-toggle" data-user="${userId}" role="group" aria-label="Rolle ändern">
        <button type="button" class="role-opt${role === 'member' ? ' is-active' : ''}" data-role="member" aria-pressed="${role === 'member'}">Mitglied</button>
        <button type="button" class="role-opt${role === 'admin' ? ' is-active' : ''}" data-role="admin" aria-pressed="${role === 'admin'}">Admin</button>
      </div>`;

    const loadUsers = async () => {
      const { data, error } = await supabase.rpc('admin_list_users');
      if (error) {
        if (userErrorEl) {
          userErrorEl.textContent = 'Mitglieder konnten nicht geladen werden: ' + error.message;
          userErrorEl.hidden = false;
        }
        return;
      }

      const rows = (data ?? []) as { user_id: string; email: string; role: string }[];
      if (rows.length === 0) {
        if (userListEl) userListEl.innerHTML = '';
        if (userEmptyEl) userEmptyEl.hidden = false;
        return;
      }
      if (userEmptyEl) userEmptyEl.hidden = true;

      const myId = session.user.id;
      if (userListEl) {
        userListEl.innerHTML = rows
          .map((u) => {
            const isSelf = u.user_id === myId;
            const roleLabel = u.role === 'admin' ? 'Admin' : 'Mitglied';
            return `
              <li${isSelf ? ' class="is-self"' : ''}>
                <span class="user-email">
                  ${escapeHtml(u.email)}
                  ${isSelf ? '<span class="self-badge">Du</span>' : ''}
                </span>
                ${
                  isSelf
                    ? `<span class="role-badge role-${u.role === 'admin' ? 'admin' : 'member'}">${roleLabel}</span>`
                    : renderRoleToggle(u.user_id, u.role)
                }
              </li>`;
          })
          .join('');
      }
    };

    userListEl?.addEventListener('click', async (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('.role-opt');
      if (!btn || btn.classList.contains('is-active')) return;

      const toggle = btn.closest<HTMLElement>('.role-toggle');
      const userId = toggle?.getAttribute('data-user');
      const newRole = btn.getAttribute('data-role');
      if (!userId || !newRole) return;

      // Die eigene Rolle darf nicht geändert werden – nur die anderer.
      if (userId === session.user.id) return;

      if (userErrorEl) userErrorEl.hidden = true;
      const buttons = toggle?.querySelectorAll<HTMLButtonElement>('.role-opt');
      buttons?.forEach((b) => (b.disabled = true));

      const { error } = await supabase.rpc('admin_set_role', {
        target: userId,
        new_role: newRole,
      });

      buttons?.forEach((b) => (b.disabled = false));

      if (error) {
        if (userErrorEl) {
          userErrorEl.textContent = 'Rolle ändern fehlgeschlagen: ' + error.message;
          userErrorEl.hidden = false;
        }
        return;
      }

      buttons?.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
    });

    await loadUsers();
  })();
</script>

<style>
  .admin-header p {
    margin-top: 0.25rem;
  }

  .panel {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 2rem;
    background: var(--bg-subtle);
  }
  .panel h2 {
    margin-top: 0;
  }

  .user-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }
  .user-list > li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .user-list > li:last-child {
    border-bottom: none;
  }
  .user-email {
    font-size: 0.95rem;
  }

  /* Rollen-Umschalter: Segment-Control im Stil der Anwendung */
  .role-toggle {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
  }
  .role-opt {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.45rem 1rem;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .role-opt:hover {
    color: var(--text);
  }
  .role-opt.is-active {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
  }
  .role-opt.is-active:hover {
    background: var(--accent-hover);
    color: #fff;
  }
  .role-opt:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  /* Eigene Zeile: Rolle nicht änderbar, nur als Badge sichtbar */
  .user-list > li.is-self .user-email {
    color: var(--text-muted);
  }
  .self-badge {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--border);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    vertical-align: middle;
  }
  .role-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1;
    border: 1px solid var(--border);
  }
  .role-badge::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }
  .role-badge.role-admin {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }
  .role-badge.role-member {
    color: var(--text-muted);
    background: var(--bg);
  }

  .form-error {
    margin: 0.75rem 0 0;
    color: #dc2626;
    font-size: 0.9rem;
  }

  .btn {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    background: var(--accent);
    color: #fff;
    border: none;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
    transition: background-color 0.15s ease;
  }
  .btn:hover {
    background: var(--accent-hover);
    color: #fff;
    text-decoration: none;
  }
</style>
