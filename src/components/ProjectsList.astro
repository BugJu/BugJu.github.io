---
const projects = [
  {
    name: 'Bachelorarbeit – Dependency-Plugins',
    description:
      'Meine Bachelorarbeit (TU Dortmund, 2026): Tool zur Analyse von ' +
      'Abhängigkeiten in Maven Java-Projekten – umgesetzt als zusammenkunft IntelliJ-Plugin und ' +
      'Maven-Plugin, samt Evaluationsprojekten.',
    tags: ['Java', 'Maven', 'IntelliJ Platform'],
    url: 'https://github.com/BugJu/BachelorThesis',
  },
  {
    name: 'IndeedScraper',
    description:
      'Ein Scraper für Stellenanzeigen auf Indeed (Deutschland, Fokus ' +
      'Softwareentwicklung). Er sammelt die Anzeigen per Selenium und wertet ' +
      'die Beschreibungen mit einem lokalen LLM (Mistral via Ollama) aus, um ' +
      'die geforderten Programmiersprachen und Frameworks zu extrahieren.',
    tags: ['Python', 'Selenium', 'Ollama'],
    url: 'https://github.com/BugJu/IndeedScrapev1',
  },
  {
    name: 'Diese Webseite',
    description:
      'Meine persönliche Portfolio- & Blog-Seite: statisch mit Astro gebaut, ' +
      'mit Supabase-Login und Rollen (Admin/Mitglied) sowie automatischem ' +
      'Deploy über GitHub Actions auf GitHub Pages.',
    tags: ['Astro', 'TypeScript', 'Supabase'],
    url: 'https://github.com/BugJu/BugJu.github.io',
  },
];
---

<ul class="projects">
  {
    projects.map((project) => (
      <li>
        <h3>
          <a href={project.url} target="_blank" rel="noopener">
            {project.name}
          </a>
        </h3>
        <p>{project.description}</p>
        <ul class="tags">
          {project.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>

<style>
  .projects {
    list-style: none;
    padding: 0;
  }
  .projects > li {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .projects h3 {
    margin: 0 0 0.35rem;
    font-size: 1.3rem;
  }
  .projects p {
    margin: 0 0 0.5rem;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }
  .tags li {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
  }
</style>
