---
const links = [
  { href: '/#start', label: 'Start', id: 'start' },
  { href: '/#projects', label: 'Projekte', id: 'projects' },
  { href: '/#about', label: 'Über mich', id: 'about' },
];

// Auf der Startseite ist "Start" initial aktiv; beim Scrollen übernimmt
// der Scrollspy auf der Startseite (index.astro) die Markierung.
const isHome = Astro.url.pathname === '/';
---

<header class="site-header">
  <nav>
    <a href="/" class="brand">BugJu</a>
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav={link.id}
              class={link.id === 'start' && isHome ? 'active' : ''}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="auth">
        <a href="/login" data-auth="login">Anmelden</a>
        <a href="/admin" data-auth="admin" hidden>Admin</a>
        <button type="button" data-auth="logout" hidden>Abmelden</button>
      </li>
      <li class="theme">
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label="Farbmodus umschalten"
          title="Hell / Dunkel umschalten"
        >
          <svg
            class="icon-moon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg
            class="icon-sun"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path>
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  import { supabase, isSupabaseConfigured } from '../lib/supabase';
  import { isAdmin } from '../lib/roles';

  // Sticky-Header-Höhe messen und als CSS-Variable bereitstellen,
  // damit Anker-Sprünge exakt unter dem Header landen.
  const headerEl = document.querySelector<HTMLElement>('.site-header');
  if (headerEl) {
    document.documentElement.style.setProperty(
      '--header-h',
      `${headerEl.offsetHeight}px`
    );
  }

  // Farbmodus-Umschalter (Mond/Sonne). Läuft unabhängig vom Login-Teil.
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark =
      document.documentElement.getAttribute('data-theme') === 'dark';
    const next = isDark ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* localStorage nicht verfügbar – egal */
    }
    themeToggle.setAttribute('aria-pressed', String(next === 'dark'));
    // Andere Skripte (z. B. der Hintergrund-Verlauf) informieren.
    document.dispatchEvent(new CustomEvent('themechange'));
  });

  // Zeigt "Anmelden" bzw. "Admin/Abmelden" je nach Login-Status
  // und Rolle (Admin-Link nur für Admins).
  (async () => {
    const loginLink = document.querySelector<HTMLAnchorElement>('[data-auth="login"]');
    const adminLink = document.querySelector<HTMLAnchorElement>('[data-auth="admin"]');
    const logoutBtn = document.querySelector<HTMLButtonElement>('[data-auth="logout"]');

    const apply = (loggedIn: boolean, admin = false) => {
      if (loginLink) loginLink.hidden = loggedIn;
      if (adminLink) adminLink.hidden = !admin;
      if (logoutBtn) logoutBtn.hidden = !loggedIn;
    };

    if (!isSupabaseConfigured) {
      apply(false);
      return;
    }

    const { data } = await supabase.auth.getSession();
    apply(Boolean(data.session), data.session ? await isAdmin() : false);

    supabase.auth.onAuthStateChange(async (_event, session) => {
      apply(Boolean(session), session ? await isAdmin() : false);
    });

    logoutBtn?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/';
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--page-bg, var(--bg)) 85%, transparent);
    backdrop-filter: blur(8px);
  }

  nav {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 0.9rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .brand {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .brand:hover {
    text-decoration: none;
    color: var(--accent);
  }

  ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  ul a {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }
  ul a:hover,
  ul a.active {
    color: var(--text);
    text-decoration: none;
  }
  ul a.active {
    color: var(--accent);
  }

  /* Login/Logout-Bereich */
  .auth {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .auth button {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  .auth button:hover {
    color: var(--text);
    text-decoration: underline;
  }

  /* Farbmodus-Umschalter */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  /* Hell: Mond anzeigen · Dunkel: Sonne anzeigen.
     Das data-theme-Attribut sitzt auf <html>, also außerhalb dieser Komponente.
     Darum :global(...) – sonst hängt Astro das Scope-Attribut an den Vorfahren
     und die Regel greift nie. */
  .theme-toggle .icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle .icon-moon {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle .icon-sun {
    display: block;
  }
</style>
