# ==========================================================
# Isolierte lokale Umgebung
# Alles bleibt im Projektordner, nichts landet global.
# ==========================================================

# Keine unnötigen Netzwerk-Checks (weniger Last, weniger Daten)
audit=false
fund=false

# Pakete nur aus vertrauenswürdigen Quellen (Sicherheit)
strict-ssl=true

# Git-Tags/Platform-Infos im Lockfile (reproduzierbare Builds)
engine-strict=false
